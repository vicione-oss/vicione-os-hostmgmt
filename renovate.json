{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>vicione-oss/tooling/renovate-orchestrator"
    ],
    "dependencyDashboard": true,
    "dependencyDashboardApproval": true,
    "enabledManagers": [ "nuget", "mise" ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "dependencyDashboardApproval": true
    },
    "osvVulnerabilityAlerts": true,
    "packageRules": [
        {
            "matchManagers": [ "nuget" ],
            "enabled": true,
            "addLabels": [ "dependency" ]
        },
        {
            "matchManagers": [ "nuget" ],
            "matchFileNames": [ "Directory.Packages.props" ],
            "matchJsonata": [ "sharedVariableName = 'DotNetVersion'" ],
            "enabled": true,
            "rebaseWhen": "never",
            "groupName": ".NET",
            "separateMajorMinor": true,
            "semanticCommits": "disabled",
            "commitMessagePrefix": "",
            "commitMessageAction": "Update to",
            "commitMessageExtra": "{{newVersion}}",
            "branchTopic": "update-to-net-{{newMajor}}-{{newMinor}}-{{newPatch}}",
            "addLabels": [ "dependency" ]
        },
        {
            "matchManagers": [ "mise" ],
            "matchDatasources": [ "dotnet-version" ],
            "enabled": true,
            "groupName": "mise dotnet",
            "branchTopic": "update-dotnet-sdk",
            "addLabels": [ "dependency" ]
        }
    ]
}
