{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>vicione-oss/tooling/renovate-orchestrator"
    ],
    "dependencyDashboard": true,
    "dependencyDashboardApproval": true,
    "enabledManagers": [ "nuget", "custom.regex" ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "dependencyDashboardApproval": true
    },
    "osvVulnerabilityAlerts": true,
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [ "/(^|/)mise\\.toml$/" ],
            "matchStrings": [
                "dotnet\\s*=\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "depNameTemplate": "dotnet-sdk",
            "datasourceTemplate": "dotnet"
        }
    ],
    "packageRules": [
        {
            "matchManagers": [ "nuget" ],
            "enabled": true,
            "addLabels": [ "dependency" ]
        },
        {
            "matchManagers": [ "nuget" ],
            "matchFileNames": [ "Directory.Packages.props" ],
            "matchJsonata": [ "sharedVariableName = 'DotNetVersion'" ],
            "enabled": true,
            "rebaseWhen": "never",
            "groupName": ".NET",
            "separateMajorMinor": true,
            "semanticCommits": "disabled",
            "commitMessagePrefix": "",
            "commitMessageAction": "Update to",
            "commitMessageExtra": "{{newVersion}}",
            "branchTopic": "update-to-net-{{newMajor}}-{{newMinor}}-{{newPatch}}",
            "addLabels": [ "dependency" ]
        },
        {
            "matchManagers": [ "custom.regex" ],
            "matchPackageNames": [ "dotnet-sdk" ],
            "enabled": true,
            "groupName": "mise dotnet",
            "branchTopic": "update-dotnet-sdk",
            "addLabels": [ "dependency" ]
        }
    ]
}
