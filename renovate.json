{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>vicione-oss/tooling/renovate-orchestrator"
    ],
    "dependencyDashboard": true,
    "dependencyDashboardApproval": true,
    "configMigration": true,
    "pruneStaleBranches": false,
    "prTitleStrict": true,
    "enabledManagers": [
        "nuget",
        "gitlabci",
        "custom.regex"
    ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "dependencyDashboardApproval": true
    },
    "osvVulnerabilityAlerts": true,
    "gitlabci": {
        "managerFilePatterns": [
            "/(^|/)\\.gitlab-ci\\.ya?ml$/",
            "/(^|/)\\.gitlab-ci\\.pipeline\\.ya?ml$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [ "/(^|/)mise\\.toml$/" ],
            "matchStrings": [ "(?m)^\\s*dotnet\\s*=\\s*\"(?<currentValue>[^\"]+)\"" ],
            "depNameTemplate": "dotnet",
            "datasourceTemplate": "dotnet-version",
            "packageNameTemplate": "dotnet-sdk",
            "versioningTemplate": "semver-coerced"
        }
    ],
    "packageRules": [
        {
            "description": "MR configuration",
            "matchManagers": [ "nuget", "gitlabci", "custom.regex" ],
            "addLabels": [ "dependency" ],
            "rebaseWhen": "auto",
            "separateMajorMinor": true,
            "separateMultipleMajor": true,
            "separateMultipleMinor": true,
            "separateMinorPatch": true
        },
        {
            "description": "MR / commit naming",
            "matchManagers": [ "nuget", "gitlabci", "custom.regex" ],
            "semanticCommits": "disabled",
            "commitMessagePrefix": "",
            "commitMessageAction": "Update"
        },
        {
            "description": "MR / commit naming for ungrouped updates",
            "matchManagers": [ "nuget", "gitlabci", "custom.regex" ],
            "commitMessageTopic": "{{{depName}}}",
            "commitMessageExtra": "to {{{newVersion}}}"
        },
        {
            "description": "MR / commit naming for grouped updates",
            "matchManagers": [ "nuget", "gitlabci", "custom.regex" ],
            "groupSingleUpdates": true,
            "recreateWhen": "never",
            "group": {
                "commitMessageTopic": "{{{groupName}}} ({{#each upgrades}}{{{depName}}}@{{{newVersion}}}{{#unless @last}}, {{/unless}}{{/each}})",
                "commitMessageExtra": ""
            }
        },
        {
            "description": "Branch naming for ungrouped updates",
            "matchManagers": [ "nuget", "gitlabci", "custom.regex" ],
            "branchTopic": "update-{{{lowercase (replace '\\.' '-' (replace '([a-z0-9])([A-Z])' '$1-$2' (replace '([A-Z]+)([A-Z][a-z])' '$1-$2' depNameSanitized)))}}}-to-{{{newMajor}}}-{{{newMinor}}}-{{{newPatch}}}"
        },
        {
            "description": "Branch naming for grouped updates",
            "matchManagers": [ "nuget", "gitlabci", "custom.regex" ],
            "group": {
                "branchTopic": "update-{{{replace '\\.' '-' (replace '^(major|minor|patch)-[0-9.]*-?' '' groupSlug)}}}"
            }
        },
        {
            "description": "NuGet: opt out of everything, then opt back in below",
            "matchManagers": [ "nuget" ],
            "enabled": false
        },
        {
            "description": "NuGet: .NET packages pinned to $(DotNetVersion)",
            "matchManagers": [ "nuget" ],
            "matchFileNames": [ "Directory.Packages.props" ],
            "matchJsonata": [ "sharedVariableName = 'DotNetVersion'" ],
            "enabled": true,
            "groupName": ".NET",
            "groupSlug": "net"
        },
        {
            "description": "NuGet: test tooling",
            "matchManagers": [ "nuget" ],
            "matchFileNames": [ "Directory.Packages.props" ],
            "matchPackageNames": [
                "AwesomeAssertions",
                "AwesomeAssertions.Analyzers",
                "Microsoft.Testing.Extensions.CodeCoverage",
                "NSubstitute",
                "NSubstitute.Analyzers.CSharp",
                "xunit.v3.mtp-v2"
            ],
            "enabled": true,
            "groupName": "test tooling",
            "groupSlug": "test-tooling",
            "separateMajorMinor": false,
            "separateMultipleMajor": false,
            "separateMultipleMinor": false,
            "separateMinorPatch": false,
            "addLabels": [ "Renovate::Frozen" ],
            "stopUpdatingLabel": "Renovate::Frozen"
        },
        {
            "description": "NuGet: TestableIO packages pinned to $(TestableIOVersion)",
            "matchManagers": [ "nuget" ],
            "matchFileNames": [ "Directory.Packages.props" ],
            "matchJsonata": [ "sharedVariableName = 'TestableIOVersion'" ],
            "enabled": true,
            "groupName": "TestableIO",
            "groupSlug": "testableio",
            "group": {
                "branchTopic": "update-{{{replace '\\.' '-' (replace '^(major|minor|patch)-[0-9.]*-?' '' groupSlug)}}}-to-{{{newMajor}}}-{{{newMinor}}}-{{{newPatch}}}",
                "commitMessageTopic": "{{{groupName}}}",
                "commitMessageExtra": "to {{{newVersion}}}"
            }
        },
        {
            "description": "NuGet: packages which can be updated in individual MRs",
            "matchManagers": [ "nuget" ],
            "matchFileNames": [ "Directory.Packages.props" ],
            "matchPackageNames": [
                "Microsoft.CodeAnalysis.CSharp",
                "minisign-net",
                "System.CommandLine"
            ],
            "enabled": true
        },
        {
            "description": "Mise: dotnet SDK",
            "matchManagers": [ "custom.regex" ],
            "matchDepNames": [ "dotnet" ],
            "enabled": true,
            "groupName": ".NET",
            "groupSlug": "net"
        },
        {
            "description": "GitLab CI: opt out of everything, then opt back in below",
            "matchManagers": [ "gitlabci" ],
            "enabled": false
        },
        {
            "description": "GitLab CI: track CI component versions",
            "matchManagers": [ "gitlabci" ],
            "matchDepTypes": [ "repository" ],
            "enabled": true,
            "groupName": "CI components",
            "groupSlug": "ci-components",
            "group": {
                "commitMessageTopic": "{{{groupName}}} ({{#each upgrades}}{{{replace '^vicione-oss/tooling/' '' depName}}}@{{{newVersion}}}{{#unless @last}}, {{/unless}}{{/each}})"
            }
        },
        {
            "description": "GitLab CI: track markdownlint-cli2 image",
            "matchManagers": [ "gitlabci" ],
            "matchDepNames": [ "davidanson/markdownlint-cli2" ],
            "enabled": true
        },
        {
            "description": "Shared settings for .NET and CI component updates",
            "matchJsonata": [ "groupName = '.NET'", "groupName = 'CI components'" ],
            "separateMajorMinor": false,
            "separateMultipleMajor": false,
            "separateMultipleMinor": false,
            "separateMinorPatch": false,
            "addLabels": [ "Renovate::Frozen" ],
            "stopUpdatingLabel": "Renovate::Frozen"
        }
    ]
}
