<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Versionierung -->
  <PropertyGroup>
    <VersionWithSuffix>$([System.IO.File]::ReadAllText('$(MsBuildThisFileDirectory)VERSION').Trim())</VersionWithSuffix>
    <!-- Version 0.1.0 ist der Standard, wenn gar keine Version gefunden wird -->
    <VersionPrefix Condition="$(VersionWithSuffix) == ''">0.1.0</VersionPrefix>
    <VersionPrefix Condition="$(VersionWithSuffix.Contains('-')) == true">$(VersionWithSuffix.Substring(0, $(VersionWithSuffix.IndexOf('-'))))</VersionPrefix>
    <VersionPrefix Condition="$(VersionWithSuffix.Contains('-')) == false">$(VersionWithSuffix)</VersionPrefix>
    <!-- Im Standardfall gibt es keinen Suffix, wenn doch wird dieser angegeben -->
    <VersionSuffix></VersionSuffix>
    <VersionSuffix Condition="$(VersionWithSuffix.Contains('-')) == true">$(VersionWithSuffix.Substring($(VersionWithSuffix.IndexOf('-'))))</VersionSuffix>
    <VersionSuffix Condition="$(VersionSuffix.Contains('-')) == true">$(VersionSuffix.Substring(1))</VersionSuffix>
    <!-- Im Standardfall ist die PackageVersion gleich der normalen "Version" -->
    <PackageVersion>$(VersionPrefix)</PackageVersion>
    <PackageVersion Condition="$(PackageVersionSuffix) != ''">$(PackageVersion).$(PackageVersionSuffix)</PackageVersion>
    <PackageVersion Condition="$(VersionSuffix) != ''">$(PackageVersion)-$(VersionSuffix)</PackageVersion>
  </PropertyGroup>

  <!-- Eigenschaften für alle Projekte des Repos -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <!-- Allgemeine Informationen -->
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>-</Description>
    <Product>ViciOne HostManagement</Product>
    <Company>ifm software</Company>
    <Year>$([System.DateTime]::Now.Year)</Year>
    <Copyright>Copyright © $(Company) $(Year)</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>

    <!-- Codequalität erhöhen -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>618</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Workaround for https://github.com/dotnet/roslyn/issues/41640 -->
    <NoWarn Condition="$(MSBuildProjectName.EndsWith('Tests'))">$(NoWarn);CS1591</NoWarn>
    <!-- NuGet Lock File -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>

  <!-- Zusätzliche Eigenschaften für alle Projekte im Ordner src (außer für SourceGeneration) -->
  <PropertyGroup Condition=
      "$(MSBuildProjectDirectory.Contains('src')) And
      !$(MSBuildProjectName.EndsWith('SourceGeneration')) And
      '$(IsPublishing)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!-- Für Repos die Projekte enthalten die als NuGet Paket veröffentlicht werden -->
  <PropertyGroup>
      <!-- https://docs.microsoft.com/de-de/nuget/reference/msbuild-targets -->
      <PackageProjectUrl>https://gitlab.com/vicione-oss/vicione/os/hostmgmt</PackageProjectUrl>
      <Authors>$(Company)</Authors>
  </PropertyGroup>

  <!-- Testprojekten Zugriff auf intern sichtbaren Quellcode geben (inklusive Mocking-Bibliotheken) -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
      <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
      <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Testprojekte erhalten automatisch 'xunit.runner.json' -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('tests'))">
      <AdditionalFiles Include="$(MSBuildThisFileDirectory)xunit.runner.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Geschwindigkeitsoptimierung für die CI-Pipelines -->
  <PropertyGroup Condition="'$(CI)' != ''">
    <!--
    <RunAnalyzers>false</RunAnalyzers>
    -->
  </PropertyGroup>

  <!-- Not active because of side effects with test coverage evaluation. -->
  <!-- PDB Dateien beim Veröffentlichen weglassen
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>None</DebugType>
  </PropertyGroup> -->

  <!-- Testprojekte sollen beim Veröffentlichen ignoriert und nicht als NuGet-Paket verpackt werden -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('tests'))">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <!-- Beispielprojekte sollen beim Veröffentlichen ignoriert und nicht als NuGet-Paket verpackt werden -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples'))">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
</Project>
