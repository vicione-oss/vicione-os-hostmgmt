<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Properties for all projects in the repo -->
  <PropertyGroup>
    <!-- General information -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>-</Description>
    <Product>ViciOne HostManagement</Product>
    <Company>ifm software</Company>
    <Year>$([System.DateTime]::Now.Year)</Year>
    <Copyright>Copyright © $(Company) $(Year)</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>

    <!-- Code quality -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>618</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet lock file -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>

  <!-- NuGet packages publish information -->
  <PropertyGroup>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://gitlab.com/vicione-oss/vicione/os/hostmgmt</PackageProjectUrl>
    <Authors>$(Company)</Authors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MsBuildThisFileDirectory)\LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Properties for source projects -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <PropertyGroup Condition=
      "$(MSBuildProjectDirectory.Contains('src')) And
      !$(MSBuildProjectName.EndsWith('SourceGeneration'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- IsPackable is individually enabled per project -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Properties for test projects -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('tests'))">
    <!-- Suppress documentation of public API -->
    <NoWarn>CS1591</NoWarn>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <!-- Test projects automatically receive 'xunit.runner.json' -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('tests'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)xunit.runner.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Properties for sample projects -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('samples'))">
    <!-- Suppress documentation of public API -->
    <NoWarn>CS1591</NoWarn>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>
</Project>
