<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Provides data contracts for system configuration and state, including validation and serialization logic.</Description>
    <RootNamespace>HostManagement.Shared</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\HostManagement.Shared.SourceGeneration\HostManagement.Shared.SourceGeneration.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Validation\ValidationResults.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ValidationResults.resx</DependentUpon>
    </Compile>
    <Compile Update="Validation\Validators\DNS\DNSValidationResults.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DNSValidationResults.resx</DependentUpon>
    </Compile>
    <Compile Update="Validation\Validators\NetworkInterfaces\NetworkInterfacesValidationResults.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>NetworkInterfacesValidationResults.resx</DependentUpon>
    </Compile>
    <Compile Update="Validation\Validators\NTP\NTPValidationResults.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>NTPValidationResults.resx</DependentUpon>
    </Compile>
    <Compile Update="Validation\Validators\Proxy\ProxyValidationResults.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ProxyValidationResults.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Validation\ValidationResults.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ValidationResults.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Validation\Validators\DNS\DNSValidationResults.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>DNSValidationResults.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Validation\Validators\NetworkInterfaces\NetworkInterfacesValidationResults.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>NetworkInterfacesValidationResults.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Validation\Validators\NTP\NTPValidationResults.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>NTPValidationResults.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Validation\Validators\Proxy\ProxyValidationResults.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ProxyValidationResults.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
