<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>hostmanagement</AssemblyName>
    <RootNamespace>HostManagement</RootNamespace>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HostManagement.Common\HostManagement.Common.csproj" />
    <ProjectReference Include="..\HostManagement.Configuration\HostManagement.Configuration.csproj" />
    <ProjectReference Include="..\HostManagement.Scripts\HostManagement.Scripts.csproj" />
    <ProjectReference Include="..\HostManagement.Shared.Communication\HostManagement.Shared.Communication.csproj" />
    <ProjectReference Include="..\HostManagement.Shared.Communication.CapabilitySerialization\HostManagement.Shared.Communication.CapabilitySerialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="minisign-net" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SystemConfig\InternalValidation\InternalValidationResultMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>InternalValidationResultMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="SystemConfig\SystemConfigResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SystemConfigResources.resx</DependentUpon>
    </Compile>
    <Compile Update="Services\ServicesResources.Designer.cs">
      <DependentUpon>ServicesResources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="SystemConfig\InternalValidation\InternalValidationResultMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>InternalValidationResultMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="SystemConfig\SystemConfigResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>SystemConfigResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Services\ServicesResources.resx">
      <LastGenOutput>ServicesResources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
