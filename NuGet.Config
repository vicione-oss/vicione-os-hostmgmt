<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="NexusPublic" value="https://nexus.nsc-gmbh.de/repository/nuget-public/index.json" protocolVersion="3" />
    <add key="NexusDev" value="https://nexus.nsc-gmbh.de/repository/nuget-dev/index.json" protocolVersion="3" />
  </packageSources>
  <!--
  <packageSourceCredentials>
    <NexusPublic>
        <add key="Username" value="##NuGet_User##" />
        <add key="ClearTextPassword" value="##NuGet_PW##" />
    </NexusPublic>
    <NexusDev>
        <add key="Username" value="##NuGet_User_RW##" />
        <add key="ClearTextPassword" value="##NuGet_PW_RW##" />
    </NexusDev>
  </packageSourceCredentials>
  -->
  <packageSourceMapping>
    <packageSource key="NexusPublic">
      <package pattern="*" />
    </packageSource>
    <packageSource key="NexusDev">
      <package pattern="ViciOne.*" />
      <package pattern="ACX.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
